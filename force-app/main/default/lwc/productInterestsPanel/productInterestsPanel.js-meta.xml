<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Product Interests (Sessao/Chamada/Contato)</masterLabel>
    <description>Exibe etiquetas de produtos de interesse para contato, sessao de mensagens ou chamada.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Contact</object>
                <object>MessagingSession</object>
                <object>VoiceCall</object>
            </objects>
            <property
                name="contactFieldApiName"
                type="String"
                label="API Name do campo de interesses (Contact)"
                description="Informe apenas o API Name do campo em Contact. Exemplo: AI_Product_Interests__c"
                default="AI_Product_Interests__c"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
